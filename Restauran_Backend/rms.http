@BASE_URL = http://localhost:3000/api/v1
@AUTH_TOKEN = 


### =========================================================================
### 1. AUTHENTICATION APIS
### =========================================================================

### 1.1 Admin Login
# @name adminLogin
POST {{BASE_URL}}/auth/login
Content-Type: application/json

{
    "email": "admin@restaurant.com",
    "password": "admin123"
}

### 1.2 Customer Login
# @name customerLogin
POST {{BASE_URL}}/auth/login
Content-Type: application/json

{
    "email": "maruf@gmail.com",
    "password": "1234567"
}

### 1.3 Sign Up New Customer
POST {{BASE_URL}}/auth/sign-up
Content-Type: application/json

{
    "fullName": "Karim Ahmed",
    "email": "karim@example.com",
    "password": "password123",
    "phone": "+8801711223344",
    "role": "customer"
}

### 1.4 Get Current User Profile (Requires Bearer Token)
GET {{BASE_URL}}/auth/me
Authorization: Bearer {{AUTH_TOKEN}}


### =========================================================================
### 2. CATEGORY APIS
### =========================================================================

### 2.1 Get All Categories
GET {{BASE_URL}}/categories?page=1&limit=20

### 2.2 Get Category By ID
GET {{BASE_URL}}/categories/1

### 2.3 Create New Category
POST {{BASE_URL}}/categories
Content-Type: application/json

{
    "categoryName": "Italian Pastas",
    "categorySlug": "italian-pastas",
    "categoryDescription": "Handcrafted traditional Italian pastas and risottos."
}

### 2.4 Update Category
PUT {{BASE_URL}}/categories/1
Content-Type: application/json

{
    "categoryName": "Gourmet Burgers & Sandwiches",
    "categorySlug": "gourmet-burgers-sandwiches",
    "categoryDescription": "Juicy artisan beef and chicken burgers."
}

### 2.5 Delete Category
DELETE {{BASE_URL}}/categories/6


### =========================================================================
### 3. FOOD ITEM APIS
### =========================================================================

### 3.1 Get All Food Items (with category JOIN and price)
GET {{BASE_URL}}/items?page=1&limit=20

### 3.2 Filter Items By Category
GET {{BASE_URL}}/items?categoryId=1

### 3.3 Search Items
GET {{BASE_URL}}/items?search=Burger

### 3.4 Get Single Item By ID
GET {{BASE_URL}}/items/1

### 3.5 Create Food Item (With Category ID & Price)
POST {{BASE_URL}}/items
Content-Type: application/json

{
    "categoryId": 1,
    "itemName": "BBQ Smoky Bacon Burger",
    "descriptions": "Beef patty topped with crispy bacon, smoked cheese, and sweet BBQ sauce.",
    "price": 380.00,
    "imageUrl": "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600&auto=format&fit=crop&q=80",
    "isAvailable": 1
}

### 3.6 Update Food Item
PUT {{BASE_URL}}/items/1
Content-Type: application/json

{
    "categoryId": 1,
    "itemName": "Classic Double Angus Beef Burger",
    "descriptions": "Double 100% Angus beef patties with cheddar cheese and pickles.",
    "price": 340.00,
    "imageUrl": "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600&auto=format&fit=crop&q=80",
    "isAvailable": 1
}

### 3.7 Delete Food Item
DELETE {{BASE_URL}}/items/10


### =========================================================================
### 4. ORDER APIS
### =========================================================================

### 4.1 Place a New Order (Multi-item transaction)
POST {{BASE_URL}}/orders
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
    "customerName": "Maruf Hossain",
    "customerEmail": "maruf@gmail.com",
    "customerPhone": "+8801811112233",
    "deliveryAddress": "Road 12, Banani, Dhaka",
    "tableNo": "Table 5",
    "paymentMethod": "cash",
    "notes": "Please deliver with extra garlic dip.",
    "items": [
        {
            "foodItemId": 1,
            "quantity": 2
        },
        {
            "foodItemId": 3,
            "quantity": 1
        }
    ]
}

### 4.2 Get All Orders (Admin Order List)
GET {{BASE_URL}}/orders?page=1&limit=20

### 4.3 Filter Orders by Status
GET {{BASE_URL}}/orders?status=pending

### 4.4 Get Logged-In User's Order History
GET {{BASE_URL}}/orders/my-orders
Authorization: Bearer {{AUTH_TOKEN}}

### 4.5 Get Single Order Details (Itemized receipt breakdown)
GET {{BASE_URL}}/orders/101

### 4.6 Update Order Status & Payment Status
PUT {{BASE_URL}}/orders/101/status
Content-Type: application/json

{
    "status": "delivered",
    "paymentStatus": "paid",
    "notes": "Delivered to Table 4 on time."
}

### 4.7 Delete / Cancel Order
DELETE {{BASE_URL}}/orders/103


### =========================================================================
### 5. DASHBOARD METRICS API
### =========================================================================

### 5.1 Get Dashboard Statistics
GET {{BASE_URL}}/dashboard/stats